# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Type checking / testing caches ----
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Packaging / build artifacts ----
build/
dist/
*.egg-info/
*.egg

# ---- macOS packaging artifacts (not for VCS) ----
# DMG / .app / icns 生成产物（仅 dist/ 下为最终产物，此处覆盖其他位置）
*.dmg
*.app
# iconutil 生成的临时 iconset 目录
*.iconset/
# PyInstaller 运行时临时解压目录（/var/folders/.../_MEI*）
# （已在系统 temp 下，此处仅防御性声明）

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Runtime artifacts ----
*.tmp
*.log

# ---- Project-local exclusions (intentionally not committed) ----
# WorkBuddy 项目记忆/工作区数据，含项目笔记，不应入库
.workbuddy/
# 生成产物（示例 docx 等）
生成示例/
# 历史残留测试文件（macOS 自动命名的临时目录）
tests/新建文件夹 (3)/
